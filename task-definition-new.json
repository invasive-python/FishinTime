{
  "containerDefinitions": [
    {
      "name": "fishintime-backend",
      "image": "462025067652.dkr.ecr.us-east-2.amazonaws.com/fishintime-backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AWS_SECRET_NAME",
          "value": "FishinSecret"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "FishinSecret_OpenAI",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:462025067652:secret:FishinSecret_OpenAI-q0M642"
        },
        {
          "name": "FishinSecret_Agent_Id",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:462025067652:secret:FishinSecret_Agent_Id-vqIBkc"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fishintime-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "fishintime-backend",
  "executionRoleArn": "arn:aws:iam::462025067652:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "taskRoleArn": "arn:aws:iam::462025067652:role/fishintime-task-role"
}
