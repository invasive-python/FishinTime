{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api:app", "--reload"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "AWS_PROFILE": "fishintime-757",
        "AWS_REGION": "us-east-2"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug API",
